/ios/
/android/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Dependências
node_modules

# Build iOS local
*.ipa
*.app
*.dSYM.zip

# Modelos SÃO versionados: o CI compila o app a partir do repositório e o
# modelo precisa entrar no bundle. Exportados no Colab a partir do .pt e
# commitados. Ver specs/001-coreml-proof/quickstart.md.
# Apenas artefatos intermediários de compilação do Core ML ficam de fora:
models/*.mlmodelc/

# Configuração local do Claude Code — pode conter credenciais.
# As skills do Spec Kit em .claude/skills/ SÃO versionadas.
.claude/settings.local.json
.claude/.credentials.json

